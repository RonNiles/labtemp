{
  "uid": "lab-temp",
  "title": "Lab Temperature",
  "tags": [
    "lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current temperature",
      "datasource": {
        "type": "influxdb",
        "uid": "labtemp-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "labtemp-influx"
          },
          "query": "import \"dict\"\nnames = [\n  \"000000C43585\": \"DS18B20-1 (000000C43585)\",\n  \"000000C45051\": \"DS18B20-2 (000000C45051)\",\n]\nfrom(bucket: \"labtemp\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: dict.get(dict: names, key: r.id, default: r.id)}))\n  |> group(columns: [\"_field\"])\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last reading",
      "datasource": {
        "type": "influxdb",
        "uid": "labtemp-influx"
      },
      "description": "Time since the sensor last reported. Red after 10 minutes: sensor down, or it can't reach the broker.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "labtemp-influx"
          },
          "query": "from(bucket: \"labtemp\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> group()\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, age: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "displayName": "ago",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temperature",
      "datasource": {
        "type": "influxdb",
        "uid": "labtemp-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "labtemp-influx"
          },
          "query": "import \"dict\"\nnames = [\n  \"000000C43585\": \"DS18B20-1 (000000C43585)\",\n  \"000000C45051\": \"DS18B20-2 (000000C45051)\",\n]\nfrom(bucket: \"labtemp\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: dict.get(dict: names, key: r.id, default: r.id)}))\n  |> group(columns: [\"_field\"])\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "spanNulls": 900000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}