{
  "uid": "lab-temp",
  "title": "Lab Temperature",
  "tags": [
    "lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "1m",
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Current temperature",
      "datasource": {
        "type": "influxdb",
        "uid": "labtemp-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "labtemp-influx"
          },
          "query": "import \"dict\"\nnames = [\n  \"000000C43585\": \"Chassis\",\n  \"000000C45051\": \"Ambient\",\n]\nfrom(bucket: \"labtemp\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: dict.get(dict: names, key: r.id, default: r.id)}))\n  |> group(columns: [\"_field\"])\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 1,
          "min": 60,
          "max": 100,
          "color": {
            "mode": "continuous-BlYlRd"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": false,
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "",
      "transparent": true,
      "datasource": {
        "type": "influxdb",
        "uid": "labtemp-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "labtemp-influx"
          },
          "query": "import \"math\"\nfrom(bucket: \"labtemp\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> group()\n  |> last()\n  |> map(fn: (r) => {\n      mins = int(v: math.ceil(x: float(v: int(v: now()) - int(v: r._time)) / 60000000000.0))\n      m = if mins < 1 then 1 else mins\n      return {_time: r._time, updated: \"Updated \" + string(v: m) + (if m == 1 then \" minute ago\" else \" minutes ago\")}\n  })\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No readings yet",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^updated$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "text": {
          "valueSize": 14
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temperature",
      "datasource": {
        "type": "influxdb",
        "uid": "labtemp-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "labtemp-influx"
          },
          "query": "import \"dict\"\nnames = [\n  \"000000C43585\": \"Chassis\",\n  \"000000C45051\": \"Ambient\",\n]\nfrom(bucket: \"labtemp\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: dict.get(dict: names, key: r.id, default: r.id)}))\n  |> group(columns: [\"_field\"])\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "spanNulls": 900000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}